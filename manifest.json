{
  "manifest_version": 3,
  "name": "Bethlehem Tools for Realm",
  "version": "0.2.4",
  "description": "Build a custom query from a list of names and open unsaved results in Realm to review, edit, or save.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Bethlehem tools",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "version_name": "0.2.4 — 2026-09-11",
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
